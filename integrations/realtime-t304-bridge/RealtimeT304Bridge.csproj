<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><Configuration Condition="'$(Configuration)'==''">Release</Configuration><OutputType>Exe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x86</PlatformTarget><OutputPath>bin\$(Configuration)\</OutputPath><AssemblyName>RealtimeT304Bridge</AssemblyName><LangVersion>7.3</LangVersion><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects></PropertyGroup>
  <ItemGroup><Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Configuration"/><Reference Include="System.Net.Http"/><Reference Include="System.Web.Extensions"/><Reference Include="System.Xml"/><Reference Include="System.Xml.Linq"/><Reference Include="System.ServiceProcess"/></ItemGroup>
  <ItemGroup><Compile Include="src\*.cs"/><Compile Include="src\sbxpc\SBXPCDLL.cs"/><None Include="App.config"/><Content Include="vendor\SBXPCDLL.dll"><Link>SBXPCDLL.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content><Content Include="vendor\SBPCCOMM.dll"><Link>SBPCCOMM.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
  <Target Name="RequireVendor" BeforeTargets="BeforeBuild"><Error Condition="!Exists('vendor\SBXPCDLL.dll') Or !Exists('vendor\SBPCCOMM.dll')" Text="Copy the official x86 SBXPCDLL.dll and SBPCCOMM.dll into vendor first."/></Target>
</Project>
