NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/srps_development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://127.0.0.1:5173
SCHOOL_NAME=Shree Ram Public School
SCHOOL_TIMEZONE=Asia/Kolkata
QR_SIGNING_SECRET=replace-with-a-separate-32-character-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DAILY_QR_EMAIL_CRON=0 6 * * *
EMAIL_SENDING_ENABLED=false
DEMO_TEACHER_PASSWORD=Teacher@123
SEED_EMAIL=principal@srps.local
SEED_PASSWORD=replace-with-a-unique-strong-password

# T304 face attendance. Generate a unique 32+ character key; share only with the Windows bridge.
ATTENDANCE_BRIDGE_API_KEY=
ATTENDANCE_BRIDGE_MOCK=false

# FkWeb PRIMARY: controlled discovery only. Disabled in NODE_ENV=production.
FKWEB_DIAGNOSTIC_MODE=false
# Absolute UTC expiry, at most one hour in the future; no indefinite capture windows.
FKWEB_DIAGNOSTIC_UNTIL=
# Independent random 32-byte hex strings. Never commit real values.
FKWEB_DIAGNOSTIC_TOKEN=
FKWEB_DIAGNOSTIC_ENCRYPTION_KEY=
# Private absolute directory outside web roots, cloud sync, source control and backups.
FKWEB_RAW_LOG_DIR=
# Optional exact source-IP allow-list. Behind proxy, allow-list the school IP at the proxy.
FKWEB_DIAGNOSTIC_ALLOWED_IPS=
FKWEB_DIAGNOSTIC_DEVICE_SERIAL=RSS202506122297

FKWEB_MAX_RAW_BODY_SIZE=1048576
FKWEB_ALLOWED_DEVICE_SERIALS=RSS202506122297
# Reference only: never pushed to the device by this application.
ORIGINAL_WEB_SERVER_URL=http://biometric.rankry.in/?school=newdemo
