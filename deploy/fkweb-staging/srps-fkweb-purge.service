[Unit]
Description=Remove expired SRPS diagnostic captures independently of receiver

[Service]
Type=oneshot
User=srps-fkweb
Group=srps-fkweb
WorkingDirectory=/opt/srps/SRPS_AI_POWERED_TIME_TABLE_ERP/server
ExecStart=/usr/bin/node --env-file=/etc/srps/fkweb-staging.env scripts/fkweb-capture.mjs purge
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/srps-fkweb/captures
